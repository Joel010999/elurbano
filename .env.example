# Tokens de demo. Reemplazalos en .env. No subas secrets reales.
URBANO_CHOFER_TOKEN=chofer-token-example
URBANO_INSPECTOR_TOKEN=inspector-token-example
URBANO_VEEDOR_TOKEN=veedor-token-example

# Redis/Upstash (opcional). Sin esto la flota y el ABM viven en memoria del proceso.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chofer (apps/driver/.env). Expo Go lee estas variables.
EXPO_PUBLIC_URBANO_API_BASE=https://colejuy-urbano.vercel.app
EXPO_PUBLIC_URBANO_CHOFER_TOKEN=chofer-token-example

# Inspector (apps/inspector/.env.local). El build de Vercel usa el default de prod si no están.
NEXT_PUBLIC_URBANO_API_BASE=https://colejuy-urbano.vercel.app
NEXT_PUBLIC_URBANO_INSPECTOR_TOKEN=inspector-token-example
NEXT_PUBLIC_URBANO_VEEDOR_TOKEN=veedor-token-example

# Google Sign-In (ID token audience). Es público: el build del inspector lo copia
# a NEXT_PUBLIC_GOOGLE_CLIENT_ID. Si queda vacío, el panel avisa en español
# y sigue el ingreso con usuario y clave (inspector-demo / 1, veedor-demo / 1).
GOOGLE_CLIENT_ID=
