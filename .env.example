# Auth tokens (replace with actual values in .env)
URBANO_CHOFER_TOKEN=chofer-token-example
URBANO_INSPECTOR_TOKEN=inspector-token-example

# Redis/Upstash (optional - falls back to in-memory if not set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Expo driver (apps/driver/.env)
# EXPO_PUBLIC_URBANO_API_BASE=https://your-deployment.vercel.app
