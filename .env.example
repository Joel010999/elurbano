# ==============================================================================
# EL URBANO — Configuración de Variables de Entorno (Producción / Railway / Local)
# ==============================================================================
# Copia este archivo a .env o configúralas en el panel de Railway (Variables).
# NUNCA subas tokens o claves reales al repositorio de Git.

# --- SERVIDOR Y ENTORNO ---
# En Railway, PORT es inyectado automáticamente por la plataforma.
PORT=3000
NODE_ENV=production

# Habilitar usuarios demo con contraseña '1' (chofer-demo, inspector-demo, veedor-demo).
# Para simulación de campo o staging, poner en 'true'.
# Para producción estricta con credenciales reales, poner en 'false'.
ENABLE_DEMO_USERS=true

# --- SEGURIDAD Y TOKENS PERSONALIZADOS ---
# Si se especifican, estos tokens tienen prioridad sobre las claves por defecto.
URBANO_CHOFER_TOKEN=
URBANO_INSPECTOR_TOKEN=
URBANO_VEEDOR_TOKEN=

# --- PERSISTENCIA (REDIS) ---
# Opción A (Recomendada en Railway):
# Agrega un plugin de Redis desde el dashboard de Railway ("+ New" -> "Database" -> "Redis").
# Railway inyectará automáticamente la variable REDIS_URL en el servicio.
REDIS_URL=

# Opción B (Upstash Redis REST):
# Si prefieres Redis serverless vía HTTP REST de Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS (DOMINIOS PERMITIDOS) ---
# Por defecto se permiten localhost, redes privadas (192.168.x.x, 10.x.x.x),
# túneles ngrok/cloudflare, y dominios *.railway.app y *.up.railway.app.
# Si usas un dominio propio personalizado (ej: https://urbano.mi-dominio.com), agrégalo acá:
URBANO_CORS_ORIGINS=

# --- APLICACIÓN CHOFER (EXPO / ANDROID) ---
# URL pública HTTPS del servidor Railway al que se conectará el chofer con datos móviles.
# Ejemplo: https://colejuy-urbano.up.railway.app
EXPO_PUBLIC_API_URL=https://tu-servicio.up.railway.app
EXPO_PUBLIC_URBANO_API_BASE=https://tu-servicio.up.railway.app

# --- AUTENTICACIÓN GOOGLE (OPCIONAL) ---
# Client ID de Google Cloud Console (OAuth 2.0 Web Client).
# Si está vacío, el sistema funciona con inicio de sesión por usuario y clave.
GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
