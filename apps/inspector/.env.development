# Valores públicos SOLO para `next dev` (npm run inspector). `next build` no lee este archivo,
# así que el build de producción sigue usando https://colejuy-urbano.vercel.app.
# No pongas secretos acá. Para pisar algo en tu máquina usá apps/inspector/.env.local (ignorado por git).

# API local levantada con `npm run dev:api` (scripts/local-server.mjs).
NEXT_PUBLIC_URBANO_API_BASE=http://localhost:3000

# Evita el "npm error code ENOWORKSPACES" al arrancar: el chequeo de versión de Next 14.2
# ejecuta `npm config get registry` desde apps/inspector, y npm lo rechaza dentro de un workspace.
# Ese chequeo solo corre con la telemetría activa.
NEXT_TELEMETRY_DISABLED=1
