{
  "name": "colejuy-urbano",
  "version": "1.0.0",
  "private": true,
  "description": "El Urbano — chofer GPS, inspector y API de flota",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:api": "tsc && node scripts/copy-api-assets.mjs",
    "dev:api": "npm run build:api && node scripts/local-server.mjs",
    "test:api": "node scripts/check-lines.mjs && node scripts/smoke.js",
    "type-check:api": "node scripts/check-lines.mjs && tsc --noEmit",
    "type-check:driver": "npm run typecheck --workspace=@urbano/driver",
    "build:web": "npm run build --workspace=@urbano/inspector && node scripts/publish-inspector.mjs",
    "build": "npm run build:web && npm run build:api",
    "start": "node scripts/local-server.mjs",
    "driver": "npm run start --workspace=apps/driver",
    "inspector": "npm run dev --workspace=apps/inspector"
  },
  "dependencies": {
    "ioredis": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "next": {
      "postcss": "^8.5.31"
    }
  }
}
